@Loans_HostAddress = http://localhost:5253

### Wyszukiwanie w dozwolonym zakresie; ustaw token klienta/pracownika
@accessToken = REPLACE_WITH_TOKEN
GET {{Loans_HostAddress}}/loan-applications/?product=retail-loan&skip=0&take=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Opcjonalny klient; obcy klient dla scope Own daje 403
GET {{Loans_HostAddress}}/loan-applications/?clientId=11111111-1111-1111-1111-111111111111&product=retail-loan
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{Loans_HostAddress}}/openapi/v1.json
Accept: application/json

###

# @name createLoanApplication
POST {{Loans_HostAddress}}/loan-applications
Content-Type: application/json

{
  "clientId": "b43c60eb-b63a-4a1a-9c63-9141ba6e873d",
  "applicantName": "Jan Kowalski",
  "amount": 50000,
  "termMonths": 36,
  "purpose": "Zakup samochodu"
}

###

@applicationId = {{createLoanApplication.response.body.$.id}}

GET {{Loans_HostAddress}}/loan-applications/{{applicationId}}
Accept: application/json

###

PUT {{Loans_HostAddress}}/loan-applications/{{applicationId}}
Content-Type: application/json

{
  "clientId": "b43c60eb-b63a-4a1a-9c63-9141ba6e873d",
  "applicantName": "Jan Kowalski",
  "amount": 60000,
  "termMonths": 48,
  "purpose": "Zakup samochodu"
}

###

POST {{Loans_HostAddress}}/loan-applications/{{applicationId}}/submit

###
