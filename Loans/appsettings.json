{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authorization": {
    "RoleMappings": [
      {
        "ClaimType": "role",
        "Value": "seller",
        "Role": "seller",
        "Actor": "employee"
      },
      {
        "ClaimType": "role",
        "Value": "operator",
        "Role": "operator",
        "Actor": "employee"
      },
      {
        "ClaimType": "role",
        "Value": "branch_advisor",
        "Role": "branch_advisor",
        "Actor": "employee"
      },
      {
        "ClaimType": "role",
        "Value": "analyst",
        "Role": "analyst",
        "Actor": "employee"
      },
      {
        "ClaimType": "roles",
        "Value": "seller",
        "Role": "seller",
        "Actor": "employee"
      },
      {
        "ClaimType": "roles",
        "Value": "operator",
        "Role": "operator",
        "Actor": "employee"
      },
      {
        "ClaimType": "roles",
        "Value": "branch_advisor",
        "Role": "branch_advisor",
        "Actor": "employee"
      },
      {
        "ClaimType": "roles",
        "Value": "analyst",
        "Role": "analyst",
        "Actor": "employee"
      },
      {
        "ClaimType": "scope",
        "Value": "seller",
        "Role": "seller",
        "Actor": "employee"
      },
      {
        "ClaimType": "scope",
        "Value": "operator",
        "Role": "operator",
        "Actor": "employee"
      },
      {
        "ClaimType": "scope",
        "Value": "branch_advisor",
        "Role": "branch_advisor",
        "Actor": "employee"
      },
      {
        "ClaimType": "scope",
        "Value": "analyst",
        "Role": "analyst",
        "Actor": "employee"
      },
      {
        "Actor": "technical",
        "ClaimType": "scope",
        "Value": "loans.read",
        "Role": "technical_reader"
      },
      {
        "Actor": "technical",
        "ClaimType": "scope",
        "Value": "loans.write",
        "Role": "technical_writer"
      }
    ],
    "ActorRoles": {
      "client": [
        "client"
      ]
    },
    "Roles": {
      "client": {
        "Services": {
          "loans": {
            "Grants": [
              {
                "Permissions": [
                  "loans.read",
                  "loans.edit",
                  "loans.submit"
                ],
                "Scope": "Own"
              },
              {
                "Permissions": [
                  "loans.create"
                ],
                "Scope": "Own",
                "Channels": [
                  "digital"
                ]
              }
            ]
          }
        }
      },
      "seller": {
        "Services": {
          "loans": {
            "Grants": [
              {
                "Permissions": [
                  "loans.read"
                ],
                "Scope": "OwnBranch"
              }
            ]
          }
        }
      },
      "operator": {
        "Services": {
          "loans": {
            "Grants": [
              {
                "Permissions": [
                  "loans.read",
                  "loans.edit"
                ],
                "Scope": "OwnBranch"
              }
            ]
          }
        }
      },
      "branch_advisor": {
        "Services": {
          "loans": {
            "Grants": [
              {
                "Permissions": [
                  "loans.read",
                  "loans.create",
                  "loans.submit"
                ],
                "Scope": "OwnBranch"
              }
            ]
          }
        }
      },
      "analyst": {
        "Services": {
          "loans": {
            "Grants": []
          }
        }
      },
      "technical_reader": {
        "Services": {
          "loans": {
            "Grants": [
              {
                "Permissions": [
                  "loans.read"
                ],
                "Scope": "All"
              }
            ]
          }
        }
      },
      "technical_writer": {
        "Services": {
          "loans": {
            "Grants": [
              {
                "Permissions": [
                  "loans.create",
                  "loans.edit",
                  "loans.submit"
                ],
                "Scope": "All"
              }
            ]
          }
        }
      }
    }
  }
}
