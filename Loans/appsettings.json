{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authorization": {
    "RoleMappings": [
      {
        "Actor": "technical",
        "ClaimType": "scope",
        "Value": "loans.read",
        "Role": "technical_reader"
      },
      {
        "Actor": "technical",
        "ClaimType": "scope",
        "Value": "loans.write",
        "Role": "technical_writer"
      }
    ],
    "Roles": {
      "client": {
        "loans.read": ["Own"],
        "loans.create": ["Own"],
        "loans.edit": ["Own"],
        "loans.submit": ["Own"]
      },
      "technical_reader": {
        "loans.read": ["All"]
      },
      "technical_writer": {
        "loans.create": ["All"],
        "loans.edit": ["All"],
        "loans.submit": ["All"]
      }
    }
  }
}
